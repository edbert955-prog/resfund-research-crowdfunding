{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "resfund/prototype-v1-2",
  "type": "project",
  "description": "ResFund Hi-Fi Interactive Prototype V1.2.1 - donation checkout, multi-project transparency, and donor dashboard",
  "keywords": [
    "laravel",
    "resfund",
    "prototype",
    "crowdfunding",
    "ui-ux"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  }
}
